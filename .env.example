# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.
# All values here are intentionally blank or safe defaults.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# AI / OpenRouter
# ---------------------------------------------------------------------------

# API key obtained from openrouter.ai
OPENROUTER_API_KEY=

# Model used for the 6h social sentiment scan (requires web search access).
# Recommended: x-ai/grok-4.20 (native xAI web search, best social reasoning)
MODEL_SOCIAL=x-ai/grok-4.20

# Model used for per-symbol deep analysis when a flag fires.
# Recommended: x-ai/grok-4.1-fast (10x cheaper, no web needed, strong JSON output)
MODEL_DEEP=x-ai/grok-4.1-fast

# Model used for position review hooks (drawdown, TP1, regime flip, funding).
# Recommended: x-ai/grok-4.1-fast (same as deep -- fast, cheap, deterministic)
MODEL_REVIEW=x-ai/grok-4.1-fast

# Optional HTTP referrer header sent to OpenRouter.
OPENROUTER_REFERER=

# Optional human-readable title header sent to OpenRouter.
OPENROUTER_TITLE=


# ---------------------------------------------------------------------------
# Exchange connectivity (Bybit)
# ---------------------------------------------------------------------------

# Main API credentials for the exchange account.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to 1 to skip all live exchange calls (useful for pure offline testing).
BYBIT_OFFLINE=


# ---------------------------------------------------------------------------
# Runtime switches
# ---------------------------------------------------------------------------

# Set to 1 to replace all AI calls with a local mock (zero spend).
AI_DRY_RUN=

# Set to 1 to allow tests that hit the live AI endpoint (costs money).
OPENROUTER_LIVE=

# Seconds a cached watchlist stays valid before a fresh AI call is made.
# Set to 0 to always re-bill on restart. Default: 900.
SCANNER_WATCHLIST_REUSE_SEC=900

# Emergency stop -- set to 1 to block ALL AI spend immediately.
AI_KILL_SWITCH=

# Maximum USD to spend on AI per calendar day (UTC). Hard cap.
DAILY_BUDGET_USD=1.00


# ---------------------------------------------------------------------------
# Risk engine (portfolio/risk.py)
# ---------------------------------------------------------------------------

# Stop-loss distance: entry ± (ATR_MULT_SL * ATR_14).
# Range: 0.5 (tight) to 2.0 (wide). Default: 1.5.
ATR_MULT_SL=1.5

# Take-profit targets as multiples of the stop distance (R:R).
TP1_RR=1.5   # partial close target (50% of position)
TP2_RR=3.0   # full exit target (remaining 50%)

# Fraction of equity to risk per trade (e.g. 0.01 = 1%).
RISK_PCT_PER_TRADE=0.01

# Maximum number of concurrent open positions.
MAX_OPEN_POSITIONS=3

# Maximum notional size per position in USD.
MAX_POSITION_USD=5000

# Portfolio-level drawdown halt (fraction). When equity drops this far
# from its peak, the scanner stops opening new positions; existing
# positions continue to be managed (SL/TP/trailing/AI close) so they can
# exit naturally. Set to 0 to disable. Default: 0.05 (5%).
MAX_DRAWDOWN_PCT=0.05

# Skip a feature snapshot if the latest bar is older than this many
# seconds (data-staleness guard). 0 disables the check.
# Suggested for 15m scanner: ~1200 (= 20 min, ~1.3x bar interval).
BAR_MAX_AGE_SEC=0


# ---------------------------------------------------------------------------
# AI prompt thresholds (templated into system prompts; A/B-testable)
# ---------------------------------------------------------------------------

# Deep analysis: skip the trade when ADX is below this value (no trend).
ADX_MIN_TRADE=18

# Deep analysis: skip threshold for the efficiency ratio (chop filter).
EFFICIENCY_MIN_TRADE=0.35

# Position review: minimum confidence for a non-hold action. Below this,
# the prompt is instructed and the code enforces "hold".
MIN_ACTION_CONFIDENCE=0.55


# ---------------------------------------------------------------------------
# Universe filter
# ---------------------------------------------------------------------------

# Minimum 24h turnover in USD to include a symbol.
# 20M USD = reasonable liquidity floor for 15m scalping.
MIN_TURNOVER_USD_24H=20000000

# Maximum bid-ask spread in basis points (10 bps = 0.1%).
MAX_SPREAD_BPS=10


# ---------------------------------------------------------------------------
# Paths and logging
# ---------------------------------------------------------------------------

# Absolute path, or relative to the container WORKDIR (/app).
# Default: /app/data
DATA_ROOT=

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------

# Host the internal API listens on.
# Use 0.0.0.0 to expose on the host network (e.g. behind a reverse proxy).
API_HOST=127.0.0.1

# Port the API binds to (must match EXPOSE in Dockerfile and ports in compose).
API_PORT=8765

# Host interface the dashboard port is published on (docker-compose only).
# Default 127.0.0.1 means the dashboard is reachable only from the VPS itself
# (use SSH tunnel or a reverse proxy with TLS for remote access).
# Set to 0.0.0.0 ONLY if you have a firewall + reverse proxy in front.
API_BIND=127.0.0.1

